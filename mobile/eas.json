{
  "cli": { "version": ">= 10.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.3martna.jo/api/v1" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.3martna.jo/api/v1" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": { "appleTeamId": "REPLACE_TEAM_ID" }
    }
  }
}
