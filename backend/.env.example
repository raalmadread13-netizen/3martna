# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated allowed origins for CORS (admin dashboard, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# ── Database (Microsoft SQL Server) ───────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Amartna
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# true when connecting to Azure SQL / TLS-required servers
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Firebase Admin (push, OTP verification, storage) ──────
# Paste the full service-account JSON as a single line, or leave
# empty to disable Firebase features in local development.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Jobs ──────────────────────────────────────────────────
# Enable node-cron scheduled jobs (invoice generation, reminders)
ENABLE_JOBS=true

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
