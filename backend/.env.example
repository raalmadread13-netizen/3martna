# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated origins allowed by CORS (web clients)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# ── Database (Microsoft SQL Server) ───────────────────────
# Leave DB_HOST empty to boot the API without a database in early sprints.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Amartna
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_POOL_MAX=10

# ── JWT ───────────────────────────────────────────────────
# Generate strong values: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# ── Firebase Admin ────────────────────────────────────────
# Full service-account JSON on one line. Empty = Firebase disabled locally.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
